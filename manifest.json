{
  "manifest_version": 3,
  "name": "Assistant extension",
  "version": "1.0",
  "permissions": [
    "contextMenus",
    "notifications",
    "nativeMessaging",
    "tabs",
    "cookies",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:12323/",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}